[node name="ControlsText" type="RichTextLabel" parent="Margin/VBox/TabContainer/⌨️ Управление"]
layout_mode = 2
bbcode_enabled = true
text = "[b]Горячие клавиши для быстрой игры:[/b]

• [b][Пробел][/b] — Начать волну / Пауза
• [b][1][/b] — Заклинание: ☄️ Метеор (350 урона)
• [b][2][/b] — Заклинание: ❄️ Заморозка всех врагов (5 сек)
• [b][3][/b] — Заклинание: 💰 Золотой дождь (+120 золота)
• [b][4][/b] — Заклинание: ⚡ Цепная молния (220 урона)
• [b][Q] [W] [E][/b] — Управление скоростью игры (Пауза / 1x / 2x)
• [b][ЛКМ][/b] — Выбор площадки, постройка, улучшение, взрыв бочек"
