[node name="MonstersText" type="RichTextLabel" parent="Margin/VBox/TabContainer/👾 Монстры"]
layout_mode = 2
bbcode_enabled = true
text = "[b]Бестиарий монстров:[/b]

• [color=#a3e635]🌱 Колюн (Spiky)[/color] — Обычный зеленый монстрик, среднее здоровье и скорость.
• [color=#fb923c]👀 Пучеглаз (Goggle)[/color] — Очень быстрый, но хрупкий.
• [color=#38bdf8]🐟 Летун (Fish Flyer)[/color] — Парит над землей.
• [color=#94a3b8]🦀 Бронированный Крабик[/color] — 50% защиты от физического урона! Бейте его Ледяными Магами и Метеорами!
• [color=#c084fc]🔮 Шаман[/color] — Лечит союзников вокруг себя. Уничтожайте в первую очередь!
• [color=#facc15]👑 Король Колючек (Босс)[/color] — Огромный запас здоровья и корона. За победу дает 50 Очков Славы!"

