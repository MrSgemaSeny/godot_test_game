class_name WeeklyChallengeController
extends Node

# ==============================================================================
# Weekly Challenge Controller
# Manages weekly curated challenges.
# ==============================================================================

var current_week_num: int = 1
var completed_weeks: Array[int] = []

func _ready() -> void:
	add_to_group("weekly_challenge_controller")
	_calculate_current_week()

func _calculate_current_week() -> void:
	current_week_num = 1 # mocked

func get_current_weekly_challenge() -> Dictionary:
	return {
		"week": current_week_num,
		"theme": "Week 1: Awakening",
		"map": "valley",
		"mutators": ["speed_freaks"]
	}

func is_challenge_completed(week_num: int) -> bool:
	return completed_weeks.has(week_num)

func claim_weekly_reward(week_num: int) -> bool:
	if not is_challenge_completed(week_num):
		completed_weeks.append(week_num)
		return true
	return false

