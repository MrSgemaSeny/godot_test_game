class_name DraftModeController
extends Node

# ==============================================================================
# Draft Mode Controller
# Handles draft mechanics for roguelite replayability.
# ==============================================================================

var current_seed: int = 0
var drafted_cards: Array[Dictionary] = []
var banished_cards: Array[String] = []
var available_pool: Array[Dictionary] = []
var active_draft_choices: Array[Dictionary] = []
var rerolls_remaining: int = 0

func _ready() -> void:
	add_to_group("draft_mode_controller")
	_init_pool()

func _init_pool() -> void:
	available_pool = [
		{"id": "tower_archer", "type": "tower", "rarity": "common"},
		{"id": "tower_mage", "type": "tower", "rarity": "rare"},
		{"id": "tower_cannon", "type": "tower", "rarity": "epic"},
		{"id": "relic_gold", "type": "relic", "rarity": "legendary"}
	]

func start_draft_run(run_seed: int) -> void:
	current_seed = run_seed
	drafted_cards.clear()
	banished_cards.clear()
	rerolls_remaining = 3

func generate_card_choices(count: int) -> Array[Dictionary]:
	active_draft_choices.clear()
	for i in range(count):
		active_draft_choices.append(available_pool[i % available_pool.size()])
	return active_draft_choices

func select_card(index: int) -> bool:
	if index < 0 or index >= active_draft_choices.size():
		return false
	drafted_cards.append(active_draft_choices[index])
	active_draft_choices.clear()
	return true

func reroll_choices() -> bool:
	if rerolls_remaining > 0:
		rerolls_remaining -= 1
		return true
	return false

func banish_card(card_id: String) -> void:
	if not banished_cards.has(card_id):
		banished_cards.append(card_id)

func get_current_deck() -> Array[Dictionary]:
	return drafted_cards

